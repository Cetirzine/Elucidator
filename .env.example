# LLM provider (server-side only; never expose the key in a browser/client)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Data providers. Credentials and licensed datasets are intentionally not committed.
TUSHARE_TOKEN=
LICENSED_MARKET_DATA_DSN=
LICENSED_NEWS_API_KEY=

# Local paths
DATA_DIR=data
ARTIFACT_DIR=artifacts

